[Unit]
Description=CyberFlow - rele por eventos del feed v2 (sensor -> srv-dmz y DC1), via bastion
After=network-online.target

[Service]
Type=simple
User=gadmin
Group=gadmin
# Codigo, feed.py y clave PUBLICA del sensor en /opt/cyberflow/relay-v2 (root:root).
# El rele verifica cada pareja feed/firma antes de entregarla; no puede firmar.
ExecStart=/usr/bin/python3 -I /opt/cyberflow/relay-v2/relay_eventos.py \
    --origen m4rk@10.10.60.11:/home/m4rk/feed-v2,/home/gadmin/.ssh/cyberflow-to-sensor \
    --destino srv-dmz=cffeed@10.10.30.10:/var/lib/cyberflow/feed,/home/gadmin/.ssh/cyberflow-to-srv-v2 \
    --destino dc1=cffeed@10.10.10.20:/var/lib/cyberflow/feed,/home/gadmin/.ssh/cyberflow-to-dc1 \
    --clave-publica /opt/cyberflow/relay-v2/pub.pem \
    --traza /home/gadmin/relay-v2/traza.jsonl --sondeo-segundos 1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
