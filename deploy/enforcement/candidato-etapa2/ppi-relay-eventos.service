[Unit]
Description=CyberFlow - rele por eventos del feed v2 (sensor -> srv-dmz y DC1), via bastion
After=network-online.target

[Service]
Type=simple
User=gadmin
Group=gadmin
ExecStart=/usr/bin/python3 /home/gadmin/relay-v2/relay_eventos.py \
    --origen m4rk@10.10.60.11:/home/m4rk/feed-v2,/home/gadmin/.ssh/cyberflow-to-sensor \
    --destino srv-dmz=adminsrvdmz@10.10.30.10:/home/adminsrvdmz/enforce-v2,/home/gadmin/.ssh/cyberflow-to-srv \
    --destino dc1=cfagente@10.10.10.20:/home/cfagente/enforce-v2,/home/gadmin/.ssh/cyberflow-to-dc1 \
    --traza /home/gadmin/relay-v2/traza.jsonl --sondeo-segundos 1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
