[Unit]
Description=PPI - captura continua de paquetes para el motor de decision en tiempo real
Documentation=file:///home/useransible/vf-sistema-final/docs/fase05-motor-tiempo-real/01-diseno-motor-tiempo-real.md
After=network-online.target suricata.service
Wants=network-online.target

[Service]
Type=simple
# Arranca como root (igual que ppi-pcap-control) y usa -Z para soltar
# privilegios al usuario tcpdump justo despues de abrir el socket crudo en
# ens35 -- mismo patron ya validado en 145+ campanas del dataset, no una
# alternativa sin probar basada en capabilities del binario.
ExecStartPre=/usr/bin/install -d -o tcpdump -g useransible -m 2750 /var/lib/ppi-motor-capture
ExecStart=/usr/bin/tcpdump -i ens35 -n -s 0 -U -B 65536 \
    -Z tcpdump -w /var/lib/ppi-motor-capture/live-%%Y%%m%%d%%H%%M%%S.pcap -G 15 -W 8 \
    (src net 10.20.0.0/24 and dst net 10.30.0.0/24) or (src net 10.30.0.0/24 and dst net 10.20.0.0/24)
UMask=0027
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
