[Unit]
Description=PPI - motor de decision en tiempo real (OCSVM + enforcement inline)
Documentation=file:///home/useransible/vf-sistema-final/docs/fase05-motor-tiempo-real/01-diseno-motor-tiempo-real.md
After=network-online.target suricata.service ppi-motor-capture.service
Wants=network-online.target
Requires=ppi-motor-capture.service

[Service]
Type=simple
User=useransible
Group=useransible
WorkingDirectory=/home/useransible/vf-sistema-final
ExecStart=/home/useransible/ppi-motor-venv/bin/python3 \
    /home/useransible/vf-sistema-final/scripts/engine/motor_decision.py \
    --eve-path /var/log/suricata/eve.json \
    --capture-dir /var/lib/ppi-motor-capture \
    --model-path /home/useransible/ppi-motor-model/ocsvm_scaled.joblib \
    --manifest-path /home/useransible/ppi-motor-model/manifest.json \
    --schema /home/useransible/vf-sistema-final/configs/features/multilayer-v2.json \
    --log-path /home/useransible/ppi-motor-logs/motor_decision.log \
    --enforce --block-timeout-seconds 120 --history-seconds 230
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Enforcement real (nftables via sudo -n a un helper root estrecho, ver
# configs/sensor/ppi-enforce + useransible-ppi-enforce.sudoers). Por eso
# NoNewPrivileges ya NO puede ser true: bloquearia el propio setuid de sudo
# necesario para escalar al helper, sin importar la politica de sudoers.
NoNewPrivileges=false
ProtectSystem=strict
ReadWritePaths=/home/useransible/ppi-motor-logs
ReadOnlyPaths=/var/lib/ppi-motor-capture /var/log/suricata

[Install]
WantedBy=multi-user.target
