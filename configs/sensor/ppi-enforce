#!/usr/bin/env bash
# Helper raiz de enforcement inline en VM02 (Sensor). El Sensor ya es el
# router entre LAN (10.20.0.0/24) y DMZ (10.30.0.0/24) via ip_forward=1 y
# nftables -- este helper agrega una tabla nftables SEPARADA y aditiva
# (prioridad -300 en el hook forward, se evalua antes que la politica de
# reenvio existente) sin tocar esa politica en absoluto. Bloquear/desbloquear
# solo modifica elementos de un set con expiracion nativa nftables (sin cron,
# sin limpieza manual). Mismo estilo defensivo que ppi-pcap-control: acciones
# fijas, sin parametros abiertos que lleguen crudos a un comando.
set -euo pipefail

readonly PATH=/usr/sbin:/usr/bin:/sbin:/bin
readonly NFT_TABLE="ppi_enforce"
readonly WHITELIST=("10.20.0.1" "10.20.0.0" "10.20.0.255")
readonly MIN_TIMEOUT=10
readonly MAX_TIMEOUT=3600

die() {
  echo "ERROR: $*" >&2
  exit 1
}

validate_ip() {
  local ip="$1"
  [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || die "IP invalida: $ip"
  local -a octets=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}")
  local octet
  for octet in "${octets[@]}"; do
    (( octet >= 0 && octet <= 255 )) || die "IP invalida: $ip"
  done
  # Alcance intencional: solo IPs LAN (10.20.0.0/24), que es exactamente el
  # entity_network que el motor puede llegar a puntuar. Cualquier otra cosa
  # (DMZ, gestion, fuera de rango) se rechaza aqui, no se confia solo en que
  # el llamador filtre bien.
  [[ "${octets[0]}.${octets[1]}.${octets[2]}" == "10.20.0" ]] || die "fuera de alcance (solo 10.20.0.0/24): $ip"
  local whitelisted
  for whitelisted in "${WHITELIST[@]}"; do
    [[ "$ip" == "$whitelisted" ]] && die "IP en whitelist, nunca se bloquea: $ip"
  done
}

ensure_setup() {
  if ! /usr/sbin/nft list table inet "$NFT_TABLE" >/dev/null 2>&1; then
    /usr/sbin/nft -f - <<NFTEOF
table inet $NFT_TABLE {
    set blocked_ips {
        type ipv4_addr
        flags timeout
    }
    chain forward {
        type filter hook forward priority -300; policy accept;
        ip saddr @blocked_ips drop
    }
}
NFTEOF
  fi
}

[[ $# -ge 1 ]] || die "uso: ppi-enforce {block IP TIMEOUT_SEG|unblock IP|status IP}"
action="$1"

case "$action" in
  block)
    [[ $# == 3 ]] || die "uso: ppi-enforce block IP TIMEOUT_SEG"
    ip="$2"
    timeout="$3"
    [[ "$timeout" =~ ^[0-9]+$ ]] || die "timeout invalido: $timeout"
    (( timeout >= MIN_TIMEOUT && timeout <= MAX_TIMEOUT )) || die "timeout fuera de rango [$MIN_TIMEOUT,$MAX_TIMEOUT]s: $timeout"
    validate_ip "$ip"
    ensure_setup
    # "add element" sobre un elemento ya presente actualiza su timeout: si
    # el ataque sigue, el bloqueo se renueva; si se detiene, expira solo.
    /usr/sbin/nft add element inet "$NFT_TABLE" blocked_ips "{ $ip timeout ${timeout}s }"
    /usr/bin/jq -n --arg ip "$ip" --argjson timeout "$timeout" \
      '{status: "blocked", ip: $ip, timeout_seconds: $timeout}'
    ;;
  unblock)
    [[ $# == 2 ]] || die "uso: ppi-enforce unblock IP"
    ip="$2"
    validate_ip "$ip"
    ensure_setup
    /usr/sbin/nft delete element inet "$NFT_TABLE" blocked_ips "{ $ip }" 2>/dev/null || true
    /usr/bin/jq -n --arg ip "$ip" '{status: "unblocked", ip: $ip}'
    ;;
  status)
    [[ $# == 2 ]] || die "uso: ppi-enforce status IP"
    ip="$2"
    validate_ip "$ip"
    if /usr/sbin/nft list set inet "$NFT_TABLE" blocked_ips 2>/dev/null | grep -qF "$ip"; then
      state="blocked"
    else
      state="not_blocked"
    fi
    /usr/bin/jq -n --arg ip "$ip" --arg state "$state" '{ip: $ip, status: $state}'
    ;;
  *)
    die "accion no permitida: $action"
    ;;
esac
