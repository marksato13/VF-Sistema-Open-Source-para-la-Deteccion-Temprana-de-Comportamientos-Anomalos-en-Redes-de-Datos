[Unit]
Description=PPI local L7 experiment API
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/ppi-api/ppi-api.py
Restart=on-failure
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/ppi-api

[Install]
WantedBy=multi-user.target
