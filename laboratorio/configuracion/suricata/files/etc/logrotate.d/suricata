# Franco's SAC - IDS (S01, 2026-11-14). Registros en ubuntu-vg/suricata-logs.
/var/log/suricata/*.log
/var/log/suricata/*.json
{
	daily
	maxsize 2G
	rotate 14
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
	sharedscripts
	postrotate
		[ -s /var/run/suricata.pid ] && /bin/kill -HUP $(cat /var/run/suricata.pid) 2>/dev/null || true
	endscript
}
