# Generado por scripts/setup/cyberflow_config.py desde configs/cyberflow.toml
# NO editar a mano: cualquier cambio se pierde en la siguiente generacion.
# Para cambiar algo, edita el .toml y vuelve a ejecutar el generador.

[Unit]
Description=CyberFlow - extraccion periodica hacia el dataset

[Timer]
# Cada 10 min sobre un anillo de 15 min: el solape cubre lo que cada pasada
# descarta por los bordes -historia truncada al principio, ventanas a medio
# llenar al final- y aguanta un retraso puntual sin dejar agujeros.
OnBootSec=8min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
